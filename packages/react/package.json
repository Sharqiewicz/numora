{
  "name": "numora-react",
  "version": "5.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "description": "React component wrapper for Numora",
  "homepage": "https://numeric-input.com/",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "numora": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Sharqiewicz/numora"
  },
  "scripts": {
    "build": "rollup -c && cp dist/index.d.ts dist/index.d.cts",
    "watch": "rollup -c -w",
    "dev": "rollup -c -w",
    "pretest": "pnpm --filter numora build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome lint --error-on-warnings ./src"
  },
  "keywords": [
    "numeric input",
    "number input",
    "currency input",
    "money input",
    "decimal input",
    "financial input",
    "defi",
    "input formatting",
    "thousand separator",
    "locale",
    "bigint",
    "precision",
    "react",
    "react-hook-form"
  ],
  "authors": [
    {
      "name": "Kacper Szarkiewicz",
      "email": "contact@sharqiewicz.com",
      "url": "https://sharqiewicz.com"
    }
  ],
  "license": "MIT",
  "devDependencies": {
    "@number-flow/react": "^0.6.0",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.56.0",
    "rollup": "^4.53.5",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "torph": "^0.1.3",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
